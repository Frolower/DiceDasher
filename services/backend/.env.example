DATABASE_URL=postgres://user_service:user_password@localhost:5432/user_db?sslmode=disable
HTTP_ADDR=:8000
LOG_MODE=default
# Generate once with: openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=dicedasher-backend
JWT_AUDIENCE=dicedasher-api
# Only for local HTTP. Use true behind HTTPS.
COOKIE_SECURE=false

# Comma-separated browser origins, without trailing slashes.
ALLOWED_ORIGINS=http://localhost:8888,http://localhost:5174
